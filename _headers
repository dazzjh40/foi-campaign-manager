# Security headers for foidirector.co.uk on Cloudflare Pages.
# These are the same headers the old Fasthosts .htaccess set.
# 'unsafe-inline' stays in script-src and style-src because several pages
# use inline <script> and <style> blocks.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io https://www.google-analytics.com; frame-ancestors 'none'; form-action 'self' https://formspree.io; base-uri 'self'

# Keep the free *.pages.dev copy of the site out of search results,
# so only foidirector.co.uk is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
